#!/usr/bin/env python3
"""Convert the sample JDT schema and save its JSON Schema output."""

from pathlib import Path

from jdt import dumps_json_schema


project_dir = Path(__file__).resolve().parent
input_file = project_dir / "jdt" / "jdtexamplefile.jdt"
output_file = input_file.with_suffix(".schema.json")

jdt_source = input_file.read_text(encoding="utf-8")
json_schema = dumps_json_schema(jdt_source)
output_file.write_text(json_schema + "\n", encoding="utf-8")

print("JSON Schema gespeichert unter:", output_file)
print(json_schema)
